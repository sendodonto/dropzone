# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Project Settings → API). The anon key is public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the site (used in auth email links and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER-ONLY. Used exclusively by scripts/grant-admin.mjs to create the first admin.
# Do not set it on Vercel unless you add server code that truly needs it. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Payments are disabled. Set only after legal validation + a provider adapter in src/lib/payments.
# PAYMENT_PROVIDER=
